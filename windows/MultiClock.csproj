<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms is referenced only for its ColorDialog, the standard
         Windows color picker, which WPF has no equivalent of. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Windows Forms wants DPI awareness set its own way; this is a WPF app,
         where app.manifest is the right place for it. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyName>MultiClock</AssemblyName>
    <RootNamespace>MultiClock</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <!-- Lets the project compile (not run) on macOS and Linux too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- The WPF SDK's implicit usings omit this one, unlike the default set. -->
    <Using Include="System.IO" />
    <!-- Keep Windows Forms out of the global namespace: its Application,
         Button, Color and friends would collide with WPF's. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hand and dial artwork, rasterized from the PDFs in
         ../Shared/Nodes/Assets.xcassets. Embedded under their bare file names. -->
    <EmbeddedResource Include="Assets/*.png" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
